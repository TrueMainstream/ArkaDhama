{
  "name": "arka-rivers",
  "main": "src/index.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "routes": [
    { "pattern": "arka.supertalk.dev", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
